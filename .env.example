# Documentation only: replace empty credentials before deployment.
# Never commit .env. Optional integrations remain disabled without credentials.
# Paths below target the Linux server; override for local use.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ENV=production
SITE_URL=https://ourpincode.com
DJANGO_ALLOWED_HOSTS=ourpincode.com,www.ourpincode.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://ourpincode.com,https://www.ourpincode.com

# Public HTTPS settings. Private HTTP testing needs explicit local overrides.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
# Raise only after verifying HTTPS; does not cover subdomains.
DJANGO_SECURE_HSTS_SECONDS=0

# Fresh database; never use root or old production credentials.
DB_NAME=ourpincode_db
DB_USER=ourpincode_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Static and media roots must be outside the checkout and must not overlap.
STATIC_ROOT=/var/lib/ourpincode/staticfiles
MEDIA_ROOT=/var/lib/ourpincode/media
CACHE_LOCATION=/var/cache/ourpincode
REDIS_URL=redis://127.0.0.1:6379/0

# SMTP needs a verified provider and outbound connectivity.
# DigitalOcean blocks standard SMTP ports. An HTTPS backend needs its own
# dependency/configuration; selecting one is a separate deployment decision.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="OUR PINCODE <noreply@ourpincode.com>"

TWO_FACTOR_API_KEY=
TWO_FACTOR_OTP_TEMPLATE=OTP1
ANTHROPIC_API_KEY=
# The database Health Settings key takes precedence over this fallback.
GROQ_API_KEY=
GOOGLE_MAPS_KEY=

SENTRY_DSN=
GIT_COMMIT=
